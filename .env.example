# Copy this file to .env.local and fill in your key.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model used to generate fresh quizzes. Default: claude-opus-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Set to "off" to skip the AI and always use the built-in question bank.
# TESTKRAFT_AI=off

# Brand name shown in the UI: TestKraft | QA Flow | PlayScript
NEXT_PUBLIC_APP_NAME=TestKraft

# SQLite file location (relative to project root)
# TESTKRAFT_DB=data/testkraft.db
